# Copy to ~/.claude/channels/slack/.env (chmod 600). Never commit real values.
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
# Optional:
# SLACK_PERMISSION_RELAY=off      # stop relaying permission prompts to the approver's DM
# SLACK_LOG_LEVEL=debug           # Slack SDK logging on stderr (warn by default)
# SLACK_CHANNEL_LOG_FILE=/Users/you/.claude/channels/slack/bridge.log   # also append bridge log lines here
